---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { hero, ui } = content;
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="column inner">
    <p class="brand" data-reveal>{t(ui.footer.brandFull, lang)}</p>
    <h1 id="hero-title" class="t-hero" data-reveal>{t(hero.offer, lang)}</h1>
    <p class="chip subline" data-reveal data-reveal-delay="150">{t(hero.subline, lang)}</p>
    <ul class="facts" role="list" data-reveal data-reveal-delay="300">
      <li class="chip fact"><span class="dot" aria-hidden="true"></span>{t(hero.availability, lang)}</li>
      <li class="chip fact">{t(hero.role, lang)}</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    display: grid;
    align-items: center;
    min-height: calc(100svh - 2 * var(--inset));
    padding-block: 6rem 8rem;
  }

  .inner {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .brand {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--label);
  }

  .t-hero {
    max-width: 14em;
  }

  .subline {
    max-width: 36rem;
    padding: 1rem 1.5rem;
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .facts {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
    width: 100%;
    max-width: 36rem;
  }

  .fact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    line-height: 1.35;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .dot {
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--tl-start);
    box-shadow: 0 0 8px var(--tl-start);
  }

  @media (min-width: 30rem) {
    .brand {
      font-size: 0.875rem;
    }
  }

  @media (min-width: 48rem) {
    .inner {
      gap: 2rem;
    }

    .brand {
      font-size: 0.9375rem;
    }

    .subline {
      padding: 1rem 2.5rem;
      font-size: 1.125rem;
    }

    .facts {
      flex-direction: row;
      justify-content: center;
    }

    .fact {
      font-size: 0.9375rem;
    }
  }
</style>

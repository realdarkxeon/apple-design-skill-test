---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';
import { localeHome } from '../lib/url';

interface Props {
  lang: Locale;
  /** Path after the locale; off the home page the CTA links back to its contact section. */
  path?: string;
}
const { lang, path = '' } = Astro.props;
const { ui } = content;
const href = path === '' ? '#contact' : `${localeHome(lang)}#contact`;
---

<div class="sticky-cta" data-sticky-cta>
  <div class="column">
    <a class="cta" href={href}>
      <span>{t(ui.header.bookCall, lang).toLocaleLowerCase(lang)}</span>
      <span aria-hidden="true">→</span>
    </a>
  </div>
</div>

<script>
  // The CTA steps aside while the booking section itself is on screen.
  const cta = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const contact = document.getElementById('contact');
  if (cta && contact) {
    new IntersectionObserver(([e]) => cta.toggleAttribute('data-hidden', e.isIntersecting), {
      rootMargin: '0px 0px -30% 0px',
    }).observe(contact);
  }
</script>

<style>
  .sticky-cta {
    position: fixed;
    left: var(--inset);
    right: var(--inset);
    bottom: var(--inset);
    z-index: 45;
    padding: 2.5rem 0 calc(0.875rem + env(safe-area-inset-bottom));
    border-radius: 0 0 var(--stage-radius) var(--stage-radius);
    /* A short dark gradient so scrolled cards don't clash with the button. */
    background: linear-gradient(to bottom, transparent, rgba(0, 0, 0, 0.45) 70%);
    pointer-events: none;
    transition:
      opacity 300ms ease,
      transform 300ms ease,
      visibility 0s linear 0s;
  }

  .sticky-cta[data-hidden] {
    opacity: 0;
    transform: translateY(12px);
    visibility: hidden;
    transition:
      opacity 300ms ease,
      transform 300ms ease,
      visibility 0s linear 300ms;
  }

  .cta {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: 100%;
    padding: 0.75rem;
    border-radius: 12px;
    background: var(--frame);
    color: #0d0d0b;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    line-height: 1.3;
    text-decoration: none;
    box-shadow: 0 0 20px 0 var(--accent-orange-glow);
    transition: box-shadow 300ms ease;
  }

  .cta:hover {
    box-shadow: 0 0 25px 0 rgba(255, 149, 0, 0.9);
  }

  .cta:active {
    transform: scale(0.99);
  }

  .cta:focus-visible {
    outline: 2px solid var(--frame);
    outline-offset: 3px;
  }

  @media (min-width: 48rem) {
    .cta {
      padding: 0.75rem 7rem;
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sticky-cta,
    .sticky-cta[data-hidden] {
      transform: none;
      transition: none;
    }
  }
</style>

---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { projects, ui } = content;
const lower = (s: string) => s.toLocaleLowerCase(lang);
---

<section class="column section-anchor" id="projects" aria-labelledby="projects-title">
  <div class="card" data-reveal>
    <p class="t-label">{t(projects.eyebrow, lang)}</p>
    <h2 id="projects-title" class="t-title">{t(projects.title, lang)}</h2>
    <table class="board">
      <caption class="visually-hidden">{t(ui.projects.summary, lang)}</caption>
      <thead>
        <tr>
          <th scope="col" class="rank">#</th>
          <th scope="col">{lower(t(ui.projects.project, lang))}</th>
          <th scope="col" class="col-client">{lower(t(ui.projects.client, lang))}</th>
        </tr>
      </thead>
      <tbody>
        {
          projects.items.map((p, i) => (
            <tr>
              <td class="rank">{i + 1}</td>
              <td>
                <a class="row-link" href={`#project-${i}`}>
                  {t(p.title, lang)}
                </a>
              </td>
              <td class="col-client t-muted">{t(p.client, lang)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {
    projects.items.map((p, i) => (
      <article class="card section-anchor" id={`project-${i}`} aria-labelledby={`project-${i}-title`} data-reveal>
        <img
          class="media"
          src={url(p.image)}
          alt={t(p.imageAlt, lang)}
          width="1600"
          height="1000"
          loading="lazy"
          decoding="async"
        />
        <div class="head">
          <p class="meta">
            <span class="stat-rank">{String(i + 1).padStart(2, '0')}</span>
            <span class="t-muted">{t(p.client, lang)}</span>
          </p>
          <h3 id={`project-${i}-title`} class="t-title">
            {t(p.title, lang)}
          </h3>
        </div>
        <dl class="facts">
          <div>
            <dt class="t-small-label">{t(ui.projects.problem, lang)}</dt>
            <dd>{t(p.problem, lang)}</dd>
          </div>
          <div>
            <dt class="t-small-label">{t(ui.projects.solution, lang)}</dt>
            <dd>{t(p.solution, lang)}</dd>
          </div>
          <div>
            <dt class="t-small-label">{t(ui.projects.result, lang)}</dt>
            <dd class="stat-row result">
              <span class="stat-value">{t(p.result, lang)}</span>
            </dd>
          </div>
        </dl>
        <figure class="signoff">
          <blockquote>
            <p>“{t(p.testimonial.quote, lang)}”</p>
          </blockquote>
          <figcaption>— {t(p.testimonial.author, lang)}</figcaption>
        </figure>
        <div class="foot">
          <span class="visually-hidden">{t(ui.projects.stack, lang)}</span>
          <ul class="stack" role="list">
            {p.stack.map((s) => (
              <li class="tag">{s}</li>
            ))}
          </ul>
          <a class="link" href={p.link} target="_blank" rel="noopener">
            {lower(t(ui.projects.viewProject, lang))} <span aria-hidden="true">↗</span>
            <span class="visually-hidden">{t(ui.a11y.opensInNewTab, lang)}</span>
          </a>
        </div>
      </article>
    ))
  }
</section>

<style>
  .board {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }

  th {
    height: 2.25rem;
    padding: 0 0.5rem;
    border-bottom: 1px solid var(--divider);
    font-weight: 400;
    text-align: left;
    color: var(--text-muted);
  }

  td {
    height: 2.5rem;
    padding: 0.5rem;
    border-bottom: 1px solid var(--divider);
    font-family: var(--font-mono);
    vertical-align: middle;
  }

  tbody tr {
    transition: background-color 150ms ease;
  }

  tbody tr:hover {
    background: rgba(255, 249, 217, 0.05);
  }

  .rank {
    width: 2.5rem;
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent-cyan);
    font-variant-numeric: tabular-nums;
  }

  .row-link {
    text-decoration: none;
  }

  .row-link:hover {
    text-decoration: underline;
  }

  .col-client {
    font-size: 0.875rem;
  }

  @media (max-width: 47.99rem) {
    .col-client {
      display: none;
    }
  }

  .media {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 10px;
    /* The illustrations are bright blue; pull them into the warm, dim palette of the stage. */
    filter: grayscale(1) sepia(0.35) brightness(0.62) contrast(1.1);
  }

  .head {
    display: grid;
    gap: 0.75rem;
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .facts {
    display: grid;
    gap: 1rem;
  }

  dd {
    margin-top: 0.25rem;
  }

  .result {
    grid-template-columns: 1fr;
  }

  .result .stat-value {
    text-align: left;
  }

  .signoff p {
    max-width: 32rem;
  }

  .signoff figcaption {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .link {
    font-family: var(--font-mono);
    font-size: 1rem;
  }
</style>

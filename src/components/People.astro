---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { people, ui } = content;
---

<section class="column section-anchor" id="people" aria-labelledby="people-title">
  <div class="card" data-reveal>
    <p class="t-label">{t(people.eyebrow, lang)}</p>
    <h2 id="people-title" class="t-title">{t(people.title, lang)}</h2>
    <ol class="list" role="list">
      {
        people.items.map((person, i) => (
          <li class="person">
            <span class="stat-rank" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="body">
              <h3 class="name">{person.name}</h3>
              <p class="t-muted who">{t(person.who, lang)}</p>
              <p>{t(person.meaning, lang)}</p>
              <a class="link" href={person.link} target="_blank" rel="noopener">
                {t(ui.people.visit, lang).toLocaleLowerCase(lang)}
                <span class="visually-hidden">: {person.name} {t(ui.a11y.opensInNewTab, lang)}</span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .list {
    display: grid;
  }

  .person {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: 0.75rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--divider);
  }

  .person .stat-rank {
    padding-top: 0.125rem;
  }

  .body {
    display: grid;
    gap: 0.375rem;
  }

  .name {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
  }

  .who {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  .link {
    justify-self: start;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
  }
</style>

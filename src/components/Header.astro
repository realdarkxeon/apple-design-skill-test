---
import { content } from '../lib/content';
import { LOCALES, t, type Locale } from '../lib/i18n';
import { localeHome } from '../lib/url';
import LanguageMenu from './LanguageMenu';
import { buttonVariants } from './ui/button';
import { cn } from '../lib/utils';

interface Props {
  lang: Locale;
  /** Show section navigation (home page only). */
  sections?: boolean;
}

const { lang, sections = true } = Astro.props;
const { ui } = content;
const navKeys = ['mission', 'services', 'projects', 'experience', 'recommendations', 'people'] as const;
const languages = LOCALES.map((code) => ({
  code,
  name: ui.languages[code].name,
  short: ui.languages[code].short,
  href: localeHome(code),
}));
---

<a class="skip-link" href="#main">{t(ui.a11y.skipLink, lang)}</a>
<header class="site-header" data-header data-sections={sections ? '' : undefined}>
  <div class="container bar">
    <a class="brand pressable" href={`${localeHome(lang)}#top`} aria-label={t(ui.header.homeLabel, lang)}>
      {ui.header.brand}
    </a>
    {
      sections && (
        <nav class="nav" aria-label={t(ui.header.navLabel, lang)}>
          <ul role="list">
            {navKeys.map((key) => (
              <li>
                <a href={`#${key}`} data-nav={key}>
                  {t(ui.nav[key], lang)}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
    <div class="actions">
      <LanguageMenu client:idle current={lang} label={t(ui.header.languageLabel, lang)} languages={languages} />
      <a class={cn(buttonVariants({ size: 'sm' }), 'header-cta')} href={`${localeHome(lang)}#contact`} data-header-cta>
        {t(ui.header.bookCall, lang)}
      </a>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const root = document.documentElement;

  if (header) {
    // Scroll edge effect: the material only appears once content is underneath it.
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // On small screens the header CTA appears once the hero CTA has scrolled away.
    const heroCta = document.querySelector('[data-hero-cta]');
    if (heroCta) {
      new IntersectionObserver(([entry]) => header.toggleAttribute('data-show-cta', !entry.isIntersecting)).observe(
        heroCta,
      );
    } else {
      header.setAttribute('data-show-cta', '');
    }

    // Track the section in view: highlights the nav item (wayfinding) and lets the
    // language menu keep the reader's place when switching language.
    const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
    const links = new Map(
      [...header.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav, a] as const),
    );
    const visible = new Set<HTMLElement>();
    const update = () => {
      const current = sections.find((s) => visible.has(s));
      const id = current?.id ?? '';
      if (root.dataset.section === id) return;
      root.dataset.section = id;
      links.forEach((a, key) => (key === id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target as HTMLElement) : visible.delete(e.target as HTMLElement);
        update();
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-top: env(safe-area-inset-top);
  }

  /* Translucent material layer (§12). Its lower edge fades out instead of a 1px divider. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -0.75rem;
    z-index: -1;
    background: var(--material);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 0.75rem), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 0.75rem), transparent);
    opacity: 0;
    transition: opacity 240ms var(--ease-out);
    pointer-events: none;
  }

  .site-header[data-scrolled]::before {
    opacity: 1;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: var(--header-h);
  }

  .brand {
    flex: none;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--text);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    margin-left: -0.25rem;
  }

  .nav {
    display: none;
    margin-inline: auto;
  }

  .nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .nav a {
    display: block;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.006em; /* small text, slight positive tracking (§15) */
    color: var(--text-2);
    text-decoration: none;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out);
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a[aria-current] {
    color: var(--text);
    background: var(--fill);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-left: auto;
  }

  @media (max-width: 25rem) {
    .bar {
      gap: 0.5rem;
    }

    .actions {
      gap: 0.375rem;
    }

    .header-cta {
      padding-inline: 0.75rem;
      font-size: 0.875rem;
    }
  }

  @media (min-width: 68rem) {
    .nav {
      display: block;
    }

    .site-header[data-sections] .actions {
      margin-left: 0;
    }
  }

  /* Small screens: the CTA materialises (scale + blur + opacity) once the hero CTA is gone (§12). */
  @media (max-width: 47.99rem) {
    .header-cta {
      transform-origin: right center;
      transition:
        opacity 220ms var(--ease-in),
        transform 220ms var(--ease-in),
        filter 220ms var(--ease-in),
        visibility 0s linear 220ms;
      opacity: 0;
      transform: scale(0.92);
      filter: blur(6px);
      visibility: hidden;
    }

    .site-header[data-show-cta] .header-cta {
      transition:
        opacity 260ms var(--ease-out),
        transform 260ms var(--ease-out),
        filter 260ms var(--ease-out),
        visibility 0s;
      opacity: 1;
      transform: none;
      filter: none;
      visibility: visible;
    }
  }

  .header-cta {
    white-space: nowrap;
  }

  /* Small screens: the CTA sits left of the language button so revealing it never shifts the button. */
  @media (max-width: 47.99rem) {
    .header-cta {
      order: -1;
    }

    .site-header[data-show-cta] .header-cta:active {
      transform: scale(0.97);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header-cta {
      transform: none !important;
      filter: none !important;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    .site-header::before {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  @media (prefers-contrast: more) {
    .site-header::before {
      background: var(--bg);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      -webkit-mask-image: none;
      mask-image: none;
      inset: 0;
      border-bottom: 1px solid var(--text);
    }
  }
</style>

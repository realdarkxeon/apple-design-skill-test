---
/**
 * Root 404 served by GitHub Pages for any missing URL. It contains the page in every
 * locale and shows the one matching the URL prefix (/ru/…, /kk/…); English otherwise.
 */
import Base from '../layouts/Base.astro';
import NotFound from '../components/NotFound.astro';
import { content } from '../lib/content';
import { DEFAULT_LOCALE, LOCALES, t } from '../lib/i18n';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<Base lang={DEFAULT_LOCALE} title={t(content.ui.notFound.title, DEFAULT_LOCALE)} noindex>
  <main id="main">
    {LOCALES.map((lang) => <NotFound lang={lang} />)}
  </main>
  <script is:inline define:vars={{ base, locales: LOCALES, titles: Object.fromEntries(LOCALES.map((l) => [l, t(content.ui.notFound.title, l)])) }}>
    const rest = location.pathname.slice(base.length).split('/').filter(Boolean);
    const lang = locales.includes(rest[0]) ? rest[0] : 'en';
    document.documentElement.lang = lang;
    document.title = titles[lang];
    document.documentElement.dataset.lang = lang;
  </script>
  <style is:global>
    html:not([data-lang]) [data-locale-block]:not([data-locale-block='en']),
    html[data-lang='en'] [data-locale-block]:not([data-locale-block='en']),
    html[data-lang='ru'] [data-locale-block]:not([data-locale-block='ru']),
    html[data-lang='kk'] [data-locale-block]:not([data-locale-block='kk']) {
      display: none;
    }
  </style>
</Base>

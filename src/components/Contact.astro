---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';
import CalEmbed from './CalEmbed';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { contact, settings, ui } = content;
const handle = (href: string) => href.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const links = [
  { label: t(ui.contact.email, lang), href: `mailto:${settings.email}`, value: settings.email, external: false },
  { label: t(ui.contact.telegram, lang), href: settings.telegram, value: handle(settings.telegram), external: true },
  { label: t(ui.contact.linkedin, lang), href: settings.linkedin, value: handle(settings.linkedin), external: true },
  { label: t(ui.contact.github, lang), href: settings.github, value: handle(settings.github), external: true },
];
---

<section class="column section-anchor" id="contact" aria-labelledby="contact-title">
  <div class="card" data-reveal>
    <p class="t-label">{t(contact.eyebrow, lang)}</p>
    <h2 id="contact-title" class="t-title">{t(contact.title, lang)}</h2>
    <p>{t(contact.intro, lang)}</p>
    <div class="booking">
      <CalEmbed
        client:visible
        calLink={settings.calUsername}
        title={t(ui.contact.calTitle, lang)}
        loadingText={t(ui.contact.calLoading, lang)}
        failedText={t(contact.embedFailed, lang)}
      />
    </div>
    <div class="fallback">
      <h3 class="t-small-label">{t(contact.fallbackTitle, lang)}</h3>
      <ul class="stat-grid" role="list">
        {
          links.map((l) => (
            <li>
              <a class="stat-row link-row" href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener me' } : {})}>
                <span class="stat-rank">{l.label.toLocaleLowerCase(lang)}</span>
                <span class="stat-value">{l.value}</span>
                {l.external && <span class="visually-hidden">{t(ui.a11y.opensInNewTab, lang)}</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .fallback {
    display: grid;
    gap: 0.75rem;
  }

  .link-row {
    text-decoration: none;
    transition: background-color 150ms ease;
  }

  .link-row:hover {
    background: rgba(255, 249, 217, 0.08);
  }

  .link-row .stat-value {
    word-break: break-all;
  }

  .booking :global(.cal) {
    position: relative;
    min-height: 34rem;
    border-radius: 12px;
    background: rgba(0, 0, 0, 0.3);
    overflow: hidden;
  }

  .booking :global(.cal[data-status='failed']) {
    min-height: 0;
  }

  .booking :global(.cal-frame) {
    width: 100%;
    min-height: 34rem;
  }

  .booking :global(.cal[data-status='failed'] .cal-frame) {
    display: none;
  }

  .booking :global(.cal-note) {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 1.5rem;
    text-align: center;
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .booking :global(.cal-failed) {
    position: static;
    color: var(--text);
  }
</style>

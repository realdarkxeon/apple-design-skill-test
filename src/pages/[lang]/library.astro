---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import People from '../../components/People.astro';
import Recommendations from '../../components/Recommendations.astro';
import Footer from '../../components/Footer.astro';
import StickyCta from '../../components/StickyCta.astro';
import { content } from '../../lib/content';
import { LOCALES, t, type Locale } from '../../lib/i18n';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const path = 'library/';
const { library } = content.ui;
---

<Base lang={lang} path={path} title={t(library.metaTitle, lang)} description={t(library.description, lang)}>
  <Header lang={lang} path={path} />
  <main id="main">
    <div class="column intro">
      <h1 class="t-hero" data-reveal>{t(library.title, lang)}</h1>
      <p class="chip lead" data-reveal data-reveal-delay="150">{t(library.intro, lang)}</p>
    </div>
    <People lang={lang} />
    <Recommendations lang={lang} />
  </main>
  <Footer lang={lang} path={path} />
  <StickyCta lang={lang} path={path} />
</Base>

<style>
  .intro {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    padding-block: clamp(7rem, 22vh, 12rem) 3rem;
    text-align: center;
  }

  .lead {
    padding: 1rem 1.5rem;
    font-size: 1.0625rem;
    line-height: 1.5;
  }
</style>

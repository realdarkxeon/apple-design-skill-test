---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { mission } = content;
const paragraphs = t(mission.body, lang).split(/\n\s*\n/);
---

<section class="column section-anchor" id="mission" aria-labelledby="mission-title">
  <div class="card" data-reveal>
    <p class="t-label">{t(mission.eyebrow, lang)}</p>
    <h2 id="mission-title" class="t-title">{t(mission.title, lang)}</h2>
    <div class="prose">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <p class="signoff">{t(mission.signature, lang)}</p>
  </div>
</section>

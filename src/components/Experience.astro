---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';
import { url } from '../lib/url';
import TimelineBar from './TimelineBar.astro';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { experience, ui } = content;
const paragraphs = t(experience.about, lang).split(/\n\s*\n/);
---

<section class="column section-anchor" id="experience" aria-labelledby="experience-title">
  <div class="card" data-reveal>
    <p class="t-label">{t(experience.eyebrow, lang)}</p>
    <h2 id="experience-title" class="t-title">{t(experience.title, lang)}</h2>
    <figure class="portrait">
      <img
        src={url(experience.portrait)}
        alt={t(experience.portraitAlt, lang)}
        width="720"
        height="900"
        loading="lazy"
        decoding="async"
      />
      <figcaption>
        <span class="name">{t(experience.name, lang)}</span>
        <span class="t-muted role">{t(experience.role, lang)}</span>
      </figcaption>
    </figure>
    <div class="prose">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>

  <div class="card" data-reveal>
    <h3 class="t-title">{t(experience.proofTitle, lang)}</h3>
    <ul class="proofs" role="list">
      {
        experience.proofs.map((item, i) => (
          <li>
            <article class="proof" aria-labelledby={`proof-${i}`}>
              <img
                class="media"
                src={url(item.image)}
                alt={t(item.imageAlt, lang)}
                width="1200"
                height="900"
                loading="lazy"
                decoding="async"
              />
              <p class="period">{t(item.period, lang)}</p>
              <h4 id={`proof-${i}`} class="proof-title">
                {t(item.title, lang)}
              </h4>
              <p>{t(item.story, lang)}</p>
              <dl class="facts">
                <div>
                  <dt class="t-small-label">{t(ui.experience.result, lang)}</dt>
                  <dd>{t(item.result, lang)}</dd>
                </div>
                <div>
                  <dt class="t-small-label">{t(ui.experience.forYou, lang)}</dt>
                  <dd>
                    <em>{t(item.forYou, lang)}</em>
                  </dd>
                </div>
              </dl>
            </article>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="card" data-reveal>
    <h3 class="t-title">{t(experience.timelineTitle, lang)}</h3>
    <TimelineBar lang={lang} rows={experience.timeline} nowLabel={t(ui.experience.now, lang)} />
  </div>

  <div class="card" data-reveal>
    <h3 class="t-title">{t(experience.whyTitle, lang)}</h3>
    <ul class="why" role="list">
      {
        experience.why.map((w) => (
          <li>
            <h4 class="t-label">{t(w.title, lang)}</h4>
            <p>{t(w.body, lang)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .portrait {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .portrait img {
    flex: none;
    width: 6rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 10px;
    filter: saturate(0.9);
  }

  .portrait figcaption {
    display: grid;
    gap: 0.125rem;
  }

  .name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.125rem;
  }

  .role {
    font-family: var(--font-mono);
    font-size: 0.875rem;
  }

  @media (min-width: 48rem) {
    .portrait img {
      width: 8rem;
    }
  }

  .proofs {
    display: grid;
    gap: 2rem;
  }

  .proofs > li + li {
    padding-top: 2rem;
    border-top: 1px solid var(--divider);
  }

  .proof {
    display: grid;
    gap: 0.625rem;
  }

  .media {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 10px;
    margin-bottom: 0.5rem;
    filter: brightness(0.88) saturate(0.85);
  }

  .period {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }

  .proof-title {
    font-family: var(--font-mono);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.25;
  }

  .facts {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  dd {
    margin-top: 0.25rem;
  }

  .why {
    display: grid;
    gap: 1.5rem;
  }

  .why li {
    display: grid;
    gap: 0.375rem;
  }
</style>

---
import { content } from '../lib/content';
import { LOCALES, t, type Locale } from '../lib/i18n';
import { localeHome, url } from '../lib/url';

interface Props {
  lang: Locale;
  /** Show the site navigation (off on the 404 page). */
  sections?: boolean;
  /** Path after the locale, e.g. 'library/'; '' is the home page. */
  path?: string;
}

const { lang, sections = true, path = '' } = Astro.props;
const { ui } = content;
const home = localeHome(lang);
const sectionKeys = ['services', 'experience', 'projects', 'mission'] as const;
const sectionHref = (key: string) => (path === '' ? `#${key}` : `${home}#${key}`);
const libraryPath = 'library/';
const lower = (s: string) => s.toLocaleLowerCase(lang);
const links = [
  ...(sections ? sectionKeys.map((key) => ({ key, href: sectionHref(key), label: lower(t(ui.nav[key], lang)), current: false })) : []),
  { key: 'library', href: `${home}${libraryPath}`, label: lower(t(ui.nav.library, lang)), current: path === libraryPath },
];
const languages = LOCALES.map((code) => ({
  code,
  name: ui.languages[code].name,
  short: ui.languages[code].short.toLocaleLowerCase(code),
  href: url(`${code}/${path}`),
}));
---

<a class="skip-link" href="#main">{t(ui.a11y.skipLink, lang)}</a>
<header class="site-header" data-header>
  <a class="logo" href={`${home}#top`} aria-label={t(ui.header.homeLabel, lang)}>
    <svg class="badge" viewBox="0 0 40 44" width="40" height="44" aria-hidden="true">
      <path d="M20 2 37.3 12v20L20 42 2.7 32V12Z" fill="none" stroke="currentColor" stroke-width="1.5" />
      <text x="20" y="29.5" text-anchor="middle">{ui.header.brand.charAt(0)}</text>
    </svg>
    <span class="wordmark" aria-hidden="true">
      <span class="wm-brand">{ui.header.brand.toLowerCase()}</span>
      <span class="wm-sub">{t(ui.header.tagline, lang)}</span>
    </span>
  </a>

  <nav class="nav" aria-label={t(ui.header.navLabel, lang)}>
    <button class="pill menu-toggle" type="button" aria-expanded="false" aria-controls="nav-list" data-menu-toggle>
      <span data-label-open>{t(ui.header.menu, lang)}</span>
      <span data-label-close hidden>{t(ui.header.closeMenu, lang)}</span>
    </button>
    <ul id="nav-list" class="nav-list" role="list" data-nav-list>
      {
        links.map((l) => (
          <li>
            <a class="pill" href={l.href} data-nav={l.key} aria-current={l.current ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        <div class="pill langs" role="group" aria-label={t(ui.header.languageLabel, lang)}>
          {
            languages.map((l) => (
              <a
                href={l.href}
                hreflang={l.code}
                lang={l.code}
                aria-current={l.code === lang ? 'page' : undefined}
                data-lang-link
              >
                <span aria-hidden="true">{l.short}</span>
                <span class="visually-hidden">{l.name}</span>
              </a>
            ))
          }
        </div>
      </li>
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const root = document.documentElement;

  if (header) {
    const onScroll = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    // Small screens: one "menu" pill opens the stack.
    const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    const setOpen = (open: boolean) => {
      header.toggleAttribute('data-open', open);
      toggle?.setAttribute('aria-expanded', String(open));
      toggle?.querySelector('[data-label-open]')?.toggleAttribute('hidden', open);
      toggle?.querySelector('[data-label-close]')?.toggleAttribute('hidden', !open);
    };
    toggle?.addEventListener('click', () => setOpen(!header.hasAttribute('data-open')));
    header.querySelectorAll('[data-nav-list] a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.hasAttribute('data-open')) {
        setOpen(false);
        toggle?.focus();
      }
    });

    // Track the section in view: highlights the nav pill and lets language links keep the reader's place.
    const sections = [...document.querySelectorAll<HTMLElement>('main section[id]')];
    const navLinks = new Map(
      [...header.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav, a] as const),
    );
    const visible = new Set<HTMLElement>();
    const update = () => {
      const id = sections.find((s) => visible.has(s))?.id ?? '';
      if (root.dataset.section === id) return;
      root.dataset.section = id;
      navLinks.forEach((a, key) => {
        if (key === 'library') return;
        key === id ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current');
      });
    };
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) e.isIntersecting ? visible.add(e.target as HTMLElement) : visible.delete(e.target as HTMLElement);
        update();
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => io.observe(s));

    header.querySelectorAll<HTMLAnchorElement>('[data-lang-link]').forEach((a) =>
      a.addEventListener('click', () => {
        const section = root.dataset.section;
        if (section) a.href = `${a.href.split('#')[0]}#${section}`;
      }),
    );
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: calc(var(--inset) + 0.75rem) calc(var(--inset) + 0.75rem) auto;
    z-index: 50;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    pointer-events: none;
  }

  .site-header > * {
    pointer-events: auto;
  }

  /* ---------------------------------------------------------------- logo */

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.625rem 0.375rem 0.375rem;
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
    transition: background-color 200ms ease;
  }

  .badge {
    flex: none;
    width: 2.25rem;
    height: auto;
  }

  .badge text {
    font-family: var(--font-logo);
    font-style: italic;
    font-size: 22px;
    fill: currentColor;
  }

  .wordmark {
    display: grid;
    font-family: var(--font-logo);
    line-height: 1.05;
  }

  .wm-brand {
    font-size: 1.375rem;
    letter-spacing: 0.01em;
  }

  .wm-sub {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  /* Over content the logo picks up the nav pill material so it never collides with card text. */
  .site-header[data-scrolled] .logo {
    background: var(--nav);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
  }

  /* ---------------------------------------------------------------- pills */

  .nav {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.75rem;
    border-radius: 8px;
    background: var(--nav);
    -webkit-backdrop-filter: blur(2px);
    backdrop-filter: blur(2px);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 1.25rem;
    line-height: 1.4;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  a.pill:hover,
  button.pill:hover {
    background: var(--nav-hover);
  }

  .pill[aria-current] {
    background: rgba(0, 0, 0, 0.45);
    box-shadow: inset 0 0 0 1px var(--divider);
  }

  .nav-list {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
  }

  .langs {
    gap: 0.25rem;
    padding-inline: 0.5rem;
    cursor: default;
  }

  .langs a {
    padding: 0 0.25rem;
    border-radius: 4px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .langs a:hover {
    color: var(--text);
  }

  .langs a[aria-current] {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Small and medium screens: compact logo, a single menu pill. */
  @media (max-width: 71.99rem) {
    .wordmark {
      display: none;
    }

    .logo {
      padding: 0.25rem;
    }

    /* Here the header sits over the cards themselves, so the faint nav fill isn't enough. */
    .site-header[data-scrolled] .logo,
    .site-header[data-scrolled] .pill {
      background: rgba(0, 0, 0, 0.6);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }

    .nav-list {
      display: none;
    }

    .site-header[data-open] .nav-list {
      display: flex;
    }

    .site-header[data-open] .pill {
      background: rgba(0, 0, 0, 0.6);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }
  }

  @media (min-width: 72rem) {
    .site-header {
      inset: calc(var(--inset) + 1.25rem) calc(var(--inset) + 1.25rem) auto;
    }

    .menu-toggle {
      display: none;
    }

    .pill {
      font-size: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo,
    .pill {
      transition: none;
    }
  }
</style>

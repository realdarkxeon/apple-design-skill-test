---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';
import ProcessDemo from './ProcessDemo';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { process, ui } = content;
const r = process.result;
---

<section class="column section-anchor" id="process" aria-labelledby="process-title">
  <div class="card" data-reveal>
    <p class="t-label">{t(process.eyebrow, lang)}</p>
    <h2 id="process-title" class="t-title">{t(process.title, lang)}</h2>
    <ProcessDemo
      client:visible
      steps={process.steps.map((s) => ({ key: s.key, title: t(s.title, lang), caption: t(s.caption, lang) }))}
      you={t(process.you, lang)}
      brand={ui.header.brand}
      pilotBadge={t(process.pilotBadge, lang)}
      result={{
        metric: t(r.metric, lang),
        beforeLabel: t(r.beforeLabel, lang),
        beforeValue: t(r.beforeValue, lang),
        afterLabel: t(r.afterLabel, lang),
        afterValue: t(r.afterValue, lang),
        source: t(r.source, lang),
      }}
      status={t(process.status, lang)}
      play={t(process.play, lang)}
      pause={t(process.pause, lang)}
    >
      <a class="more" href="#contact">{t(process.cta, lang)} <span aria-hidden="true">→</span></a>
    </ProcessDemo>
  </div>
</section>

<style>
  .more {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    color: var(--text);
  }
</style>

---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { hero } = content;
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="container hero-inner">
    <p class="status t-footnote"><span class="dot" aria-hidden="true"></span>{t(hero.availability, lang)}</p>
    <h1 id="hero-name" class="name">{t(hero.name, lang)}</h1>
    <p class="t-display offer">{t(hero.offer, lang)}</p>
    <p class="t-lead subline">{t(hero.subline, lang)}</p>
    <div class="ctas">
      <a class="button" href="#contact" data-hero-cta>{t(hero.primaryCta, lang)}</a>
      <a class="button button--quiet" href="#projects">{t(hero.secondaryCta, lang)}</a>
    </div>
    <p class="role t-footnote">{t(hero.role, lang)}</p>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1rem, -0.5rem + 5vw, 6rem) clamp(3.5rem, 2rem + 6vw, 7rem);
  }

  .hero-inner {
    display: grid;
    justify-items: start;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3125rem 0.75rem;
    border-radius: 999px;
    background: var(--fill);
    color: var(--text-2);
    font-weight: 500;
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--positive);
  }

  .name {
    margin-top: clamp(1rem, 0.6rem + 1.5vw, 1.5rem);
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    line-height: 1.3;
    letter-spacing: -0.005em;
    font-weight: 600;
    color: var(--text-2);
  }

  .offer {
    margin-top: 0.5rem;
    max-width: 17em;
    text-wrap: balance;
  }

  .subline {
    margin-top: clamp(1rem, 0.85rem + 0.6vw, 1.25rem);
    max-width: 36rem;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 1.2rem + 1.2vw, 2rem);
  }

  .role {
    margin-top: 1.5rem;
    color: var(--text-3);
  }

  @media (max-width: 30rem) {
    .ctas {
      width: 100%;
    }

    .ctas .button {
      flex: 1 1 100%;
    }
  }
</style>

---
import { content } from '../lib/content';
import { LOCALES, t, type Locale } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  lang: Locale;
  /** Path after the locale, so the language links keep the current page. */
  path?: string;
}
const { lang, path = '' } = Astro.props;
const { ui } = content;
const year = new Date().getFullYear();
---

<footer class="column footer">
  <div class="chip inner">
    <div>
      <p class="brand">{ui.header.brand.toLowerCase()}</p>
      <p class="t-muted small">{t(ui.footer.brandFull, lang)}</p>
    </div>
    <nav aria-label={t(ui.header.languageLabel, lang)}>
      <ul role="list" class="langs">
        {
          LOCALES.map((code) => (
            <li>
              <a href={url(`${code}/${path}`)} hreflang={code} lang={code} aria-current={code === lang ? 'page' : undefined}>
                {ui.languages[code].name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="t-muted small">{t(ui.footer.copyright, lang).replace('{year}', String(year))}</p>
    <a class="small top" href="#top">{t(ui.footer.backToTop, lang)} <span aria-hidden="true">↑</span></a>
  </div>
</footer>

<style>
  /* Leaves room for the sticky CTA under the last card. */
  .footer {
    padding-bottom: calc(var(--cta-h) + 3rem + env(safe-area-inset-bottom));
  }

  .inner {
    display: grid;
    gap: 1rem;
    padding: 1.25rem 1.5rem;
  }

  @media (min-width: 40rem) {
    .inner {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }

  .brand {
    font-family: var(--font-logo);
    font-size: 1.375rem;
    line-height: 1.1;
  }

  .small {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .langs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }

  .langs a {
    display: inline-block;
    padding-block: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-muted);
    text-decoration: none;
  }

  .langs a:hover,
  .langs a[aria-current] {
    color: var(--text);
    text-decoration: underline;
  }
</style>

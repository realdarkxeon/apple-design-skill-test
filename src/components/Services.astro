---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { services } = content;
const rank = (i: number) => String(i + 1).padStart(2, '0');
---

<section class="column section-anchor" id="services" aria-labelledby="services-title">
  <div class="card" data-reveal>
    <p class="t-label">{t(services.eyebrow, lang)}</p>
    <h2 id="services-title" class="t-title">{t(services.title, lang)}</h2>
    <p>{t(services.intro, lang)}</p>

    <ul class="stat-grid" role="list">
      {
        services.items.map((item, i) => (
          <li class="stat-row">
            <span class="stat-rank">{rank(i)}</span>
            <span class="stat-value">{t(item.metric, lang)}</span>
          </li>
        ))
      }
    </ul>

    <ol class="items" role="list">
      {
        services.items.map((item, i) => (
          <li class="item" data-service={item.key}>
            <h3 class="item-title">
              <span class="stat-rank">{rank(i)}</span>
              <span>{t(item.title, lang)}</span>
            </h3>
            <p>{t(item.description, lang)}</p>
            <p class="example">{t(item.example, lang)}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .items {
    display: grid;
    gap: 1.5rem;
  }

  .item {
    display: grid;
    gap: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--divider);
  }

  .item-title {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: lowercase;
  }

  .example {
    font-style: italic;
    color: var(--text-muted);
  }
</style>

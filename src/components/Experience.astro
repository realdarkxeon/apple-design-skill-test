---
import { content } from '../lib/content';
import { formatMonth, t, type Locale } from '../lib/i18n';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { experience, ui } = content;
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t(experience.eyebrow, lang)}</p>
      <h2 id="experience-title" class="t-title">{t(experience.title, lang)}</h2>
    </div>
    <ol class="timeline" role="list">
      {
        experience.items.map((item) => (
          <li class="entry">
            <p class="period t-footnote">
              <time datetime={item.start}>{formatMonth(item.start, lang)}</time>
              <span aria-hidden="true"> – </span>
              {item.end ? <time datetime={item.end}>{formatMonth(item.end, lang)}</time> : t(ui.experience.present, lang)}
            </p>
            <div class="what">
              <h3 class="t-headline">{t(item.role, lang)}</h3>
              <p class="org">{t(item.organization, lang)}</p>
              <p class="impact">{t(item.impact, lang)}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Rows separated by hairlines instead of a dotted timeline. */
  .timeline {
    display: grid;
    max-width: 52rem;
    border-top: 1px solid var(--separator);
  }

  .entry {
    display: grid;
    gap: 0.375rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--separator);
  }

  .period {
    color: var(--text-3);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .org {
    font-size: 0.9375rem;
    color: var(--text-2);
    font-weight: 500;
  }

  .impact {
    margin-top: 0.25rem;
    color: var(--text-2);
    max-width: 38rem;
  }

  @media (min-width: 48rem) {
    .entry {
      grid-template-columns: 13rem 1fr;
      gap: 1.5rem;
    }

    .period {
      padding-top: 0.125rem;
    }
  }
</style>

---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';
import { url } from '../lib/url';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { projects, ui } = content;
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t(projects.eyebrow, lang)}</p>
      <h2 id="projects-title" class="t-title">{t(projects.title, lang)}</h2>
    </div>
    <ul class="grid" role="list">
      {
        projects.items.map((p, i) => (
          <li>
            <article class="card" aria-labelledby={`project-${i}`}>
              <img
                class="media"
                src={url(p.image)}
                alt={t(p.imageAlt, lang)}
                width="1600"
                height="1000"
                loading="lazy"
                decoding="async"
              />
              <div class="body">
                <p class="t-footnote client">{t(p.client, lang)}</p>
                <h3 id={`project-${i}`} class="t-headline">
                  {t(p.title, lang)}
                </h3>
                <dl class="facts">
                  <div>
                    <dt>{t(ui.projects.problem, lang)}</dt>
                    <dd>{t(p.problem, lang)}</dd>
                  </div>
                  <div>
                    <dt>{t(ui.projects.solution, lang)}</dt>
                    <dd>{t(p.solution, lang)}</dd>
                  </div>
                  <div class="result">
                    <dt>{t(ui.projects.result, lang)}</dt>
                    <dd>{t(p.result, lang)}</dd>
                  </div>
                </dl>
                <figure class="quote">
                  <blockquote>
                    <p>{t(p.testimonial.quote, lang)}</p>
                  </blockquote>
                  <figcaption>— {t(p.testimonial.author, lang)}</figcaption>
                </figure>
                <div class="stack">
                  <span class="visually-hidden">{t(ui.projects.stack, lang)}</span>
                  <ul role="list">
                    {p.stack.map((s) => (
                      <li>{s}</li>
                    ))}
                  </ul>
                </div>
                <a class="link" href={p.link} target="_blank" rel="noopener">
                  {t(ui.projects.viewProject, lang)}
                  <span aria-hidden="true">↗</span>
                  <span class="visually-hidden">{t(ui.a11y.opensInNewTab, lang)}</span>
                </a>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr));
  }

  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .media {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--fill);
  }

  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, 1rem + 1vw, 2rem);
  }

  .client {
    color: var(--text-3);
    font-weight: 500;
  }

  .facts {
    display: grid;
    gap: 0.875rem;
    margin-top: 0.25rem;
  }

  dt {
    font-size: 0.8125rem;
    line-height: 1.38;
    letter-spacing: 0.012em;
    font-weight: 600;
    color: var(--text-3);
  }

  dd {
    margin-top: 0.125rem;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--text-2);
  }

  .result dd {
    color: var(--text);
    font-weight: 600;
  }

  .quote {
    margin-top: 0.5rem;
    padding: 1rem 1.125rem;
    border-radius: var(--radius);
    background: var(--fill);
  }

  .quote p {
    font-size: 1rem;
    line-height: 1.47;
    color: var(--text);
  }

  .quote figcaption {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    letter-spacing: 0.012em;
    color: var(--text-3);
  }

  .stack ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .stack li {
    padding: 0.1875rem 0.625rem;
    border-radius: 999px;
    border: 1px solid var(--separator);
    font-size: 0.8125rem;
    line-height: 1.4;
    letter-spacing: 0.012em;
    color: var(--text-2);
  }

  .link {
    display: inline-flex;
    gap: 0.25rem;
    align-self: flex-start;
    margin-top: auto;
    padding-block: 0.5rem;
    font-weight: 600;
  }

  @media (prefers-contrast: more) {
    .card {
      box-shadow: none;
      border: 1px solid var(--text);
    }
  }
</style>

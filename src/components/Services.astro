---
import { content } from '../lib/content';
import { t, type Locale } from '../lib/i18n';
import Spotlight from './reactbits/Spotlight';
import FadeContent from './reactbits/FadeContent';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const { services } = content;
---

<section class="section" id="services" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{t(services.eyebrow, lang)}</p>
      <h2 id="services-title" class="t-title">{t(services.title, lang)}</h2>
      <p class="t-lead">{t(services.intro, lang)}</p>
    </div>
    <ul class="grid" role="list">
      {
        services.items.map((item, i) => (
          <li data-service={item.key}>
            <FadeContent client:visible className="fade" duration={700} delay={i * 90} threshold={0.15}>
              <Spotlight client:visible className="card">
                <h3 class="t-headline">{t(item.title, lang)}</h3>
                <p class="t-body desc">{t(item.description, lang)}</p>
                <div class="outcome">
                  <p class="metric">{t(item.metric, lang)}</p>
                  <p class="t-footnote example">{t(item.example, lang)}</p>
                </div>
              </Spotlight>
            </FadeContent>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
  }

  /* The card and its fade wrapper are rendered by React islands, outside this component's style scope. */
  .grid > li,
  .grid :global(astro-island),
  .grid :global(.fade) {
    display: flex;
    flex-direction: column;
  }

  .grid :global(astro-island),
  .grid :global(.fade),
  .grid :global(.card) {
    flex: 1;
  }

  .grid :global(.card) {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    box-shadow: var(--shadow-sm);
  }

  .desc {
    color: var(--text-2);
  }

  .outcome {
    display: grid;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .metric {
    font-family: var(--font-heading);
    font-size: clamp(1.25rem, 1.15rem + 0.4vw, 1.5rem);
    line-height: 1.12;
    letter-spacing: -0.018em;
    font-weight: 700;
    color: var(--link);
    font-variant-numeric: tabular-nums;
  }

  .example {
    color: var(--text-3);
  }

  @media (prefers-contrast: more) {
    .grid :global(.card) {
      box-shadow: none;
      border: 1px solid var(--text);
    }
  }
</style>
